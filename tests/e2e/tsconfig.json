{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"types": ["@playwright/test", "node"]
	},
	"include": ["specs/**/*.ts", "fixtures/**/*.ts", "playwright.config.ts"]
}
