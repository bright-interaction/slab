# Dependencies
node_modules/
.pnp
.pnp.js

# Build artifacts (run `make frontend` to regenerate before `go build`)
dist/
/build/
.next/
out/
frontend/.svelte-kit/
frontend/build/
# Embedded frontend build target for cmd/server/main.go's go:embed. Keep only
# the .gitkeep so the embed compiles on a fresh checkout / the public mirror.
/cmd/server/frontend/build/*
!/cmd/server/frontend/build/.gitkeep

# Environment
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
coverage/
.nyc_output/

# Cache
.cache/
.parcel-cache/
.turbo/

# Misc
*.tsbuildinfo

# Compiled Go binary
bin/

# Slab runtime data (DB, workspaces, media)
data/

# Playwright e2e artifacts
tests/e2e/test-results/
tests/e2e/playwright-report/
tests/e2e/node_modules/
tests/e2e/.tmp/

# Compiled deploy artifact (tracked historically; OSS distributions should
# not ship a binary). Run `make build` to produce bin/slab locally.
/server

# CI rebuild marker. Edit + push to force a deploy in an internal deployment.
# Not relevant for OSS users / GitHub mirror.
.deploy-trigger
