# Slab environment configuration
#
# Copy this file to `.env` (or to `.env.docker` for Docker Compose). Never commit
# real values. Local dev (BASE_URL=http://localhost:8080) keeps the lenient
# defaults. Production deploys (any other BASE_URL) refuse to start until every
# secret below is overridden.
#
# Product-specific vars use the SLAB_ prefix. The pre-rename ATOMICSITE_ prefix
# is still accepted as a fallback for every SLAB_ var (SLAB_ wins when both are
# set), so an existing env-file from before the Slab rename keeps working
# unchanged. New deployments should use the SLAB_ names below.

# ── Server ──────────────────────────────────────────────────────────────
# Port the Go server listens on. Reverse proxy in front of it.
PORT=8080
# Where SQLite, uploaded media, and self-hosted fonts persist. Mount a
# volume here in containers.
DATA_DIR=./data
# Public URL of the admin server. Must be HTTPS in production or session
# cookies (Secure attribute) won't travel and login won't stick.
BASE_URL=http://localhost:8080
# Max request body in bytes. 20 MB default. Affects media uploads.
MAX_UPLOAD_SIZE=20971520
# Comma-separated widths for media variants (responsive image generation).
MEDIA_VARIANTS=320,640,1280,1920

# ── Auth + secrets ──────────────────────────────────────────────────────
# Session JWT signing key. At least 32 bytes. Generate with:
#   openssl rand -hex 32
JWT_SECRET=change-me-in-production
# Initial admin user, seeded on first boot if no users exist.
# Min 12 characters in production. Local dev allows the documented default.
ADMIN_EMAIL=admin@slab.dev
ADMIN_PASSWORD=changeme123
# Optional. Bearer token guarding POST /admin/reload-secrets so a secrets
# manager can rotate values without restarting the container.
ADMIN_RELOAD_TOKEN=

# ── Domain ──────────────────────────────────────────────────────────────
# The apex domain this Slab instance serves (e.g. example.com).
# Required in production unless BUILT_SITE_SUFFIX is set instead. Used as
# the canonical "what domain am I building for?" answer in agent context
# and as the default seed for fresh sites' cookieproof_domain / canonical
# base / CORS allow-list.
SLAB_PRIMARY_DOMAIN=
# Multi-tenant subdomain shape. Set ONLY if every tenant gets a wildcard
# subdomain like <slug>.your-platform.com. Widens CORS to accept any
# origin whose hostname ends with this suffix. Leave empty for the
# typical single-root deployment.
BUILT_SITE_SUFFIX=

# ── Deployment mode ─────────────────────────────────────────────────────
# Selects between the OSS single-root shape and the Cloud multi-tenant shape.
#   single  Default. One Slab instance for one root domain.
#   cloud   Multi-tenant edge orchestration (requires the `ee` build tag).
# Setting cloud without `-tags ee` refuses to start.
SLAB_DEPLOYMENT_MODE=single

# ── Analytics + tracking ────────────────────────────────────────────────
# Public path prefix for visitor tracking endpoints (e.g. /t/visitor).
TRACK_PATH=/t
# Server-side salt mixed into visitor fingerprint hashes so fingerprints
# stay stable per-visitor but cannot be reversed to identify them.
# Generate with: openssl rand -hex 32
ANALYTICS_SALT=slab-default-fingerprint-salt-change-me

# 32-byte at-rest + MCP-shield key. REQUIRED in production: without it TOTP
# seeds and app-install credentials are stored unencrypted and the MCP server
# forwards order PII to the LLM unredacted (the server refuses to start in
# production when this is unset or not exactly 32 bytes). Generate with:
#   head -c 24 /dev/urandom | base64
SLAB_SHIELD_KEY=

# ── Optional: outbound webhook integration ──────────────────────────────
# Slab can POST identified visitor events and form submissions to
# any HTTP webhook receiver. BrightCRM is one supported example; the URL
# can point at any service that accepts JSON + a shared HMAC signature.
# Leave both empty to disable; crmsync becomes a no-op.
BRIGHTCRM_WEBHOOK_URL=
# Shared HMAC secret. Used both to sign outbound calls and to verify
# inbound /t/inbound pings. Generate with: openssl rand -hex 32
BRIGHTCRM_WEBHOOK_SECRET=
# Previous secret value, accepted by the inbound verifier during a
# rotation grace window. Outbound signing always uses the current value.
BRIGHTCRM_WEBHOOK_SECRET_PREVIOUS=
# Throttle non-identified events per (site, visitor) in seconds.
# Identified events bypass the throttle.
CRM_SYNC_MIN_INTERVAL_SECONDS=60

# ── Custom-domain provisioning (optional, host integration) ─────────────
# Setting these on a host with nginx + certbot turns on the live-domain
# pipeline (see internal/domains). Leave blank in dev / OSS containers
# without root: slab still records site_domains rows, but no
# nginx fragments are written and no certs are issued.
#
# /etc/nginx/conf.d auto-include directory. The reconciler writes
# slab-acme.conf (port 80 helper) and slab-domain-map.conf
# here; nginx loads them automatically inside the http{} scope.
SLAB_NGINX_CONF_DIR=
# /etc/nginx/sites-enabled (or wherever your distro pulls server{}
# blocks from). One file per verified custom domain lands here.
SLAB_NGINX_SITES_DIR=
# Webroot certbot uses for HTTP-01 challenges. Must match the path the
# reconciler-rendered slab-acme.conf serves /.well-known/acme-
# challenge/ from. Default suggested layout: /var/www/acme.
SLAB_ACME_WEBROOT=
# Path to certbot. Empty disables cert issuance (rows stop at
# 'verified' until you wire it up).
SLAB_CERTBOT_PATH=
# Email address registered with Let's Encrypt.
SLAB_LE_EMAIL=
# Reload command run after writing fragments. Wrap nginx -t + reload
# in a sudoer-whitelisted script so the container can call it without
# broad sudo. Sample script: ops/slab-nginx-reload.sh.
SLAB_NGINX_RELOAD_CMD=
# Public IP shown to admins as the A-record target ("point your
# domain at this IP").
SLAB_EDGE_IP=
# Optional Cloudflare auto-DNS for zones we control. When the admin
# adds a hostname under one of these zones, the reconciler creates
# the A record automatically. Format: apex1=zoneID1,apex2=zoneID2
SLAB_CLOUDFLARE_ZONES=
# Cloudflare API token with Zone.DNS:Edit on every zone above.
SLAB_CLOUDFLARE_TOKEN=

# ── Hardening ───────────────────────────────────────────────────────────
# Trusted reverse-proxy IPs / CIDRs whose X-Forwarded-For and X-Real-IP
# headers we honor. When EMPTY, those headers are ignored entirely and
# audit_log + rate limiters see r.RemoteAddr (the real TCP peer). When
# set, only proxy peers in this list can rewrite the client IP via XFF.
# That stops a directly-exposed slab from accepting client-supplied
# XFF as gospel. Bare IPs auto-widen to /32 (v4) or /128 (v6).
#
# Examples:
#   SLAB_TRUSTED_PROXIES=127.0.0.1/32,::1/128       # localhost-only nginx
#   SLAB_TRUSTED_PROXIES=10.0.0.0/8                  # private VPC LB
#   SLAB_TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1     # Docker bridge + nginx
SLAB_TRUSTED_PROXIES=

# Multi-factor authentication enforcement. Empty = optional MFA (users
# may enroll, not gated). "admin" = users with role=admin must enroll.
# "all" = every authenticated user must enroll. When enforcement is
# active, login still succeeds (the cookie is issued so the user can
# complete enrollment) but the response carries `enroll_required: true`
# and write requests outside the TOTP / change-password / logout paths
# are blocked with 403 + error_code=mfa_enroll_required until the user
# enrolls.
SLAB_REQUIRE_MFA=

# Per-process audit_log retention window in days. Empty / 0 keeps the
# default of 365 days (the GDPR + ISO 27001 proof-of-controls floor).
# Values are clamped to the [7, 3650] range; a misconfigured "1" can't
# silently drain the log. Pair any reduction below 365 with an
# out-of-band export job before the daily sweep clears the rows.
SLAB_AUDIT_LOG_RETENTION_DAYS=

# ── OIDC SSO (#5, 2026-05-10) ────────────────────────────────────────────
# Optional. When OIDC_ENABLED=false (the shipping default) the SSO
# endpoints return 404 and the login page hides the "Sign in with SSO"
# button. Works against any OIDC-compliant issuer (Authentik, Auth0,
# Keycloak, Zitadel) because we discover endpoints via
# /.well-known/openid-configuration.
#
# Provisioning model:
#   - SSO email matches an existing user -> issue session, log them in
#   - No matching user + email domain in OIDC_ALLOW_DOMAINS -> auto-create
#     a passwordless admin user and log them in
#   - No matching user + domain not allowlisted -> redirect with sso_no_account
#
# Auto-created users have an empty PasswordHash so the password login
# path can never authenticate them (only the OIDC callback can issue a
# session for those accounts).
OIDC_ENABLED=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_ALLOW_DOMAINS=

# ── Reference ───────────────────────────────────────────────────────────
# Full configuration reference: README.md "Configuration" section.
# Every variable above is read by internal/config/config.go. Adding a new
# variable requires updating both this file AND that one (per CONTRIBUTING.md).
