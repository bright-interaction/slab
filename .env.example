# Atomic Site environment configuration
#
# Copy this file to `.env` (or to `.env.docker` for Docker Compose). Never commit
# real values. Local dev (BASE_URL=http://localhost:8080) keeps the lenient
# defaults. Production deploys (any other BASE_URL) refuse to start until every
# secret below is overridden.

# ── Server ──────────────────────────────────────────────────────────────
# Port the Go server listens on. Reverse proxy in front of it.
PORT=8080
# Where SQLite, uploaded media, and self-hosted fonts persist. Mount a
# volume here in containers.
DATA_DIR=./data
# Public URL of the admin server. Must be HTTPS in production or session
# cookies (Secure attribute) won't travel and login won't stick.
BASE_URL=http://localhost:8080
# Max request body in bytes. 20 MB default. Affects media uploads.
MAX_UPLOAD_SIZE=20971520
# Comma-separated widths for media variants (responsive image generation).
MEDIA_VARIANTS=320,640,1280,1920

# ── Auth + secrets ──────────────────────────────────────────────────────
# Session JWT signing key. At least 32 bytes. Generate with:
#   openssl rand -hex 32
JWT_SECRET=change-me-in-production
# Initial admin user, seeded on first boot if no users exist.
# Min 12 characters in production. Local dev allows the documented default.
ADMIN_EMAIL=admin@atomicsite.dev
ADMIN_PASSWORD=changeme123
# Optional. Bearer token guarding POST /admin/reload-secrets so a secrets
# manager can rotate values without restarting the container.
ADMIN_RELOAD_TOKEN=

# ── Domain ──────────────────────────────────────────────────────────────
# The apex domain this Atomic Site instance serves (e.g. example.com).
# Required in production unless BUILT_SITE_SUFFIX is set instead. Used as
# the canonical "what domain am I building for?" answer in agent context
# and as the default seed for fresh sites' cookieproof_domain / canonical
# base / CORS allow-list.
ATOMICSITE_PRIMARY_DOMAIN=
# Multi-tenant subdomain shape. Set ONLY if every tenant gets a wildcard
# subdomain like <slug>.your-platform.com. Widens CORS to accept any
# origin whose hostname ends with this suffix. Leave empty for the
# typical single-root deployment.
BUILT_SITE_SUFFIX=

# ── Deployment mode ─────────────────────────────────────────────────────
# Selects between the OSS single-root shape and the Cloud multi-tenant shape.
#   single  Default. One Atomic Site instance for one root domain.
#   cloud   Multi-tenant edge orchestration (requires the `ee` build tag).
# Setting cloud without `-tags ee` refuses to start.
ATOMICSITE_DEPLOYMENT_MODE=single

# ── Analytics + tracking ────────────────────────────────────────────────
# Public path prefix for visitor tracking endpoints (e.g. /t/visitor).
TRACK_PATH=/t
# Server-side salt mixed into visitor fingerprint hashes so fingerprints
# stay stable per-visitor but cannot be reversed to identify them.
# Generate with: openssl rand -hex 32
ANALYTICS_SALT=atomicsite-default-fingerprint-salt-change-me

# ── Optional: outbound webhook integration ──────────────────────────────
# Atomic Site can POST identified visitor events and form submissions to
# any HTTP webhook receiver. BrightCRM is one supported example; the URL
# can point at any service that accepts JSON + a shared HMAC signature.
# Leave both empty to disable; crmsync becomes a no-op.
BRIGHTCRM_WEBHOOK_URL=
# Shared HMAC secret. Used both to sign outbound calls and to verify
# inbound /t/inbound pings. Generate with: openssl rand -hex 32
BRIGHTCRM_WEBHOOK_SECRET=
# Previous secret value, accepted by the inbound verifier during a
# rotation grace window. Outbound signing always uses the current value.
BRIGHTCRM_WEBHOOK_SECRET_PREVIOUS=
# Throttle non-identified events per (site, visitor) in seconds.
# Identified events bypass the throttle.
CRM_SYNC_MIN_INTERVAL_SECONDS=60

# ── Reference ───────────────────────────────────────────────────────────
# Full configuration reference: README.md "Configuration" section.
# Every variable above is read by internal/config/config.go. Adding a new
# variable requires updating both this file AND that one (per CONTRIBUTING.md).
