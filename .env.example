# Atomicsite environment configuration
# Copy to .env.docker on the deploy host. Never commit real values.

# ── Server ──────────────────────────────────────────────────────────────
PORT=8080
DATA_DIR=/data
BASE_URL=https://app.slab.example.com
JWT_SECRET=your_jwt_secret_change_me
MAX_UPLOAD_SIZE=20971520
MEDIA_VARIANTS=320,640,1280,1920

# ── Analytics + tracking (Phase 10) ─────────────────────────────────────
TRACK_PATH=/t
ANALYTICS_SALT=your_analytics_salt_change_me

# ── CookieProof integration ─────────────────────────────────────────────
COOKIEPROOF_API_BASE=https://consent.example.com
COOKIEPROOF_ADMIN_TOKEN=your_cookieproof_admin_token

# ── BrightCRM integration (Phase 18, bidirectional) ─────────────────────
# Outbound: where atomicsite POSTs identified events (the CRM webhook).
BRIGHTCRM_WEBHOOK_URL=https://crm.example.com/webhooks/atomicsite
# Shared HMAC secret. The SAME value must be set in three places:
#   - here (used for both signing outbound and verifying inbound)
#   - WEBHOOK_SECRET_ATOMICSITE  in brightcrm/.env.docker
#   - ATOMICSITE_INBOUND_SECRET  in brightcrm/.env.docker
# Generate with: openssl rand -hex 32
BRIGHTCRM_WEBHOOK_SECRET=your_shared_atomicsite_brightcrm_hmac_secret
# Throttle non-identified events per (site, visitor). Identified events bypass.
CRM_SYNC_MIN_INTERVAL_SECONDS=60

# ── Built-site CORS allowlist (Phase 18) ────────────────────────────────
# Built sites live on subdomains of this suffix and reach /t/visitor +
# /t/inbound cross-origin. The CORS middleware widens to accept any
# hostname ending with this suffix.
BUILT_SITE_SUFFIX=.slab.example.com
