---
/* Auto-generated by Atomicsite. Replaced during build with site-specific layout. */
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  robots?: string;
  lang?: string;
}

const {
  title,
  description = '',
  ogImage = '',
  robots = 'index, follow',
  lang = 'en',
} = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <meta name="robots" content={robots} />
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>
  <slot name="header" />
  <main>
    <slot />
  </main>
  <slot name="footer" />
</body>
</html>
